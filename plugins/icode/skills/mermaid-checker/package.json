{
  "name": "@yangzhuo/mermaid-checker",
  "version": "1.0.0",
  "description": "Fast Mermaid diagram syntax validator for Markdown files",
  "type": "module",
  "bin": {
    "mermaid-check": "./bin/mermaid-check.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "package.json"
  ],
  "scripts": {
